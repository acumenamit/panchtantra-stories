{
  "name": "storyboard",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --port 3005",
    "build": "tsx scripts/load-content.ts && next build",
    "content:load": "tsx scripts/load-content.ts",
    "start": "next start --port 3005",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "migrate:convert": "tsx tools/migrate/cli.ts",
    "migrate:validate": "tsx tools/migrate/validate-cli.ts",
    "narration:plan": "tsx tools/narration/cli.ts plan",
    "narration:run": "tsx tools/narration/cli.ts run",
    "narration:export": "tsx tools/narration/parler-cli.ts export",
    "narration:ingest": "tsx tools/narration/parler-cli.ts ingest",
    "narration:listened": "tsx tools/narration/parler-cli.ts listened",
    "spike": "tsx tools/spikes/cli.ts"
  },
  "dependencies": {
    "canonicalize": "5.1.0",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "fast-check": "4.10.2",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
